{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "build": {
      "model": "google/gemini-3.1-flash-lite-preview",
      "prompt": "{file:./prompts/gemini.txt}"
    },

    "plan": {
      "model": "google/gemini-3.1-pro-preview",
      "prompt": "{file:./prompts/gemini.txt}"
    }
  },

  "permission": {
    "edit": {
      "opencode.json": "deny",
      ".opencode/*": "deny"
    }
  }
}
